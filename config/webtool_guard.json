{
    "_comment": "Synapse Agent 网络工具安全策略。enabled=false 时退化为原始行为（不推荐）。",
    "enabled": true,
    "scheme_whitelist": ["http", "https"],
    "port_whitelist": [80, 443],
    "block_private_ip": true,
    "ip_blacklist": [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "::1/128",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8"
    ],
    "allow_redirects": true,
    "max_redirects": 5,
    "max_response_bytes": 5242880,
    "timeout_seconds": 20,
    "ping": {
        "enabled": true,
        "host_pattern": "^[A-Za-z0-9][A-Za-z0-9.\\-]{0,252}$",
        "count": 4,
        "timeout_seconds": 10
    }
}